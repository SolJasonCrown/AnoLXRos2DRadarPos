#!/usr/bin/env bash
# FishROS installer launcher.
# Modified for this package: when a local install.py exists, prefer local files so
# the custom Autoinstall migration in tools/ is actually used.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SUDO=""
if [ "${EUID:-$(id -u)}" -ne 0 ]; then
    SUDO="sudo"
fi

if ! python3 -c 'import distro, yaml' >/dev/null 2>&1; then
    $SUDO apt-get update -y
    $SUDO apt-get install -y python3-distro python3-yaml
fi

if [ -f "$SCRIPT_DIR/install.py" ] && [ "${FISHROS_FORCE_REMOTE:-0}" != "1" ]; then
    export FISHROS_LOCAL=1
    export FISHROS_URL=""
    cd "$SCRIPT_DIR" || exit 1
    $SUDO -E python3 "$SCRIPT_DIR/install.py"
else
    export FISHROS_LOCAL=0
    export FISHROS_URL="${FISHROS_URL:-http://mirror.fishros.com/install/}"
    mkdir -p /tmp/fishinstall/tools/translation/assets
    wget "$FISHROS_URL/install.py" -O /tmp/fishinstall/install.py 2>/dev/null
    $SUDO -E python3 /tmp/fishinstall/install.py
    $SUDO rm -rf /tmp/fishinstall/
fi

if [ -f fishros ]; then
    $SUDO rm -f fishros
fi

# Reload the current user's shell configuration when possible.
if [ -n "${BASH_VERSION:-}" ] && [ -f "$HOME/.bashrc" ]; then
    # shellcheck disable=SC1090
    source "$HOME/.bashrc"
elif [ -n "${ZSH_VERSION:-}" ] && [ -f "$HOME/.zshrc" ]; then
    # shellcheck disable=SC1090
    source "$HOME/.zshrc"
fi
